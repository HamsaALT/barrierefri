    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.3",
    "react-leaflet": "5.0.0",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "3.8.1",
    "typescript": "~7.0.2",
