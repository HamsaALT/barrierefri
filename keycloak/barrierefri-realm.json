{
  "realm": "barrierefri",
  "enabled": true,
  "displayName": "Barrierefri",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "da",
    "en"
  ],
  "defaultLocale": "da",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "Can report barriers and confirm reports"
      },
      {
        "name": "staff",
        "description": "Municipal or operator staff who handle cases"
      },
      {
        "name": "admin",
        "description": "Full access"
      },
      {
        "name": "default-roles-barrierefri",
        "description": "Given to everyone who signs up",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "citizen"
          ]
        }
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-barrierefri"
  },
  "clients": [
    {
      "clientId": "barrierefri-web",
      "name": "Barrierefri web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    }
  ],
